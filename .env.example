# Copia este archivo a .env.local (NO se sube a GitHub) o defínelo en Vercel → Settings → Environment Variables.
# Sin estas variables la app funciona en MODO LOCAL (sin servidor): las funciones compartidas muestran "requiere backend".
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=clave-publica-anon
# Dominio interno que convierte el usuario "lela" en "lela@cimiento.app" para Supabase Auth.
# Debe ser el MISMO que AUTH_EMAIL_DOMAIN de la Edge Function admin-users.
VITE_AUTH_EMAIL_DOMAIN=cimiento.app
# NUNCA pongas aquí la clave service_role: solo vive como secreto de las Edge Functions o en tu equipo para tools/backend/.
